# ==========================================================
# .env.example — انسخه إلى .env وعدّل القيم
# ==========================================================

DEBUG=true

SECRET_KEY=generate-a-long-random-string-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# MySQL (الإنتاج الموصى به):
DATABASE_URL=mysql+pymysql://ust_user:STRONG_PASSWORD@localhost:3306/ust_chatbot?charset=utf8mb4
# SQLite (تطوير):
# DATABASE_URL=sqlite:///./ust_dev.db

OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=25

EMBEDDINGS_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.28

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

CORS_ORIGINS=*
